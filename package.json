    "validate:reference-standards": "node scripts/compile-atlas.mjs --preflight",
    "validate:data": "node scripts/validate-repository.mjs",
    "validate:repository": "node scripts/validate-repository.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:search": "node scripts/validate-search.mjs",
