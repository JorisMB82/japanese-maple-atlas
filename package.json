{
  "name": "japanese-maple-atlas-mvp",
  "version": "0.9.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "compile:atlas": "node scripts/compile-atlas.mjs",
    "compile:atlas:check": "node scripts/compile-atlas.mjs --check",
    "compile:check": "npm run compile:atlas:check",
    "contribution:new": "node scripts/create-contribution.mjs",
    "validate:contributions": "node scripts/validate-contributions.mjs",
    "validate:data": "node scripts/validate-repository.mjs",
    "validate:repository": "node scripts/validate-repository.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:search": "node scripts/validate-search.mjs",
    "validate:graph": "node scripts/validate-graph.mjs",
    "validate:quality": "node scripts/validate-quality.mjs",
    "verify:repository": "npm run validate:contributions && npm run compile:atlas:check && npm run validate:schemas && npm run validate:repository && npm run validate:search && npm run validate:graph",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "test:regression": "node --test tests/regression",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "prebuild": "npm run verify:repository",
    "build": "next build",
    "start": "next start",
    "verify": "npm run test && npm run test:coverage && npm run build && npm run test:regression && npm run validate:quality",
    "release:manifest": "node scripts/generate-release-manifest.mjs"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
