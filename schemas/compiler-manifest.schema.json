{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/manifest.schema.json",
  "title": "Atlas Compiler Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositoryVersion",
    "release",
    "generatedAt",
    "compiler",
    "source",
    "objectCounts",
    "objectTotal",
    "repositoryHash",
    "canonicality",
    "notes"
  ],
  "properties": {
    "repositoryVersion": {
      "const": "0.6.0"
    },
    "objectTotal": {
      "const": 166
    },
    "repositoryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonicality": {
      "const": "canonical-compiled"
    }
  }
}
