{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/manifest.schema.json",
  "title": "Atlas Compiler Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositoryVersion",
    "release",
    "generatedAt",
    "compiler",
    "source",
    "editorial",
    "objectCounts",
    "objectTotal",
    "repositoryHash",
    "canonicality",
    "notes"
  ],
  "properties": {
    "repositoryVersion": {
      "const": "0.7.0"
    },
    "release": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "compiler": {
      "type": "object",
      "required": [
        "name",
        "version",
        "deterministic"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "records",
        "inputHash"
      ]
    },
    "editorial": {
      "type": "object",
      "required": [
        "contributors",
        "submissions",
        "workflows",
        "reviews",
        "lifecycleStages",
        "reviewPasses"
      ]
    },
    "objectCounts": {
      "type": "object",
      "required": [
        "cultivars",
        "assertions",
        "evidence",
        "sources",
        "taxa",
        "relationships",
        "media",
        "contributors",
        "submissions",
        "editorialWorkflows",
        "editorialReviews"
      ]
    },
    "objectTotal": {
      "const": 203
    },
    "repositoryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonicality": {
      "const": "canonical-compiled"
    },
    "notes": {
      "type": "string"
    }
  }
}
