{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/source.schema.json",
  "title": "Atlas Source Object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "citation",
        "sourceType",
        "authority",
        "version",
        "freezeDate",
        "path",
        "sha256",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{6}$"
        },
        "title": {
          "type": "string",
          "minLength": 10
        },
        "citation": {
          "type": "string",
          "minLength": 10
        },
        "sourceType": {
          "const": "frozen-reference-standard"
        },
        "authority": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "minLength": 3
        },
        "freezeDate": {
          "type": "string",
          "minLength": 4
        },
        "path": {
          "type": "string",
          "pattern": "^atlas-repository/reference-standards/RC-[0-9]{3}\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "frozen"
        },
        "underlyingSourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-RC-[0-9]{3}-[0-9]{3}$"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "citation",
        "sourceType",
        "authority",
        "status",
        "recordIds",
        "generatedFrom",
        "domainScope",
        "sourceLocations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-RC-[0-9]{3}-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "citation": {
          "type": "string",
          "minLength": 3
        },
        "sourceType": {
          "type": "string",
          "minLength": 3
        },
        "authority": {
          "type": "string",
          "minLength": 2
        },
        "status": {
          "const": "approved"
        },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^RC-[0-9]{3}$"
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessedAt": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string"
        },
        "domainScope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "sourceLocations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "generatedFrom": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "compilerVersion"
          ]
        }
      }
    }
  ]
}
