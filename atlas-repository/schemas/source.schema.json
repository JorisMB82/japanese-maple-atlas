{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/source.schema.json",
  "title": "Frozen Reference Standard Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "citation",
    "sourceType",
    "authority",
    "version",
    "freezeDate",
    "path",
    "sha256",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SRC-[0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 10
    },
    "citation": {
      "type": "string",
      "minLength": 10
    },
    "sourceType": {
      "const": "frozen-reference-standard"
    },
    "authority": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "minLength": 3
    },
    "freezeDate": {
      "type": "string",
      "minLength": 4
    },
    "path": {
      "type": "string",
      "pattern": "^atlas-repository/reference-standards/RC-[0-9]{3}\\.md$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "frozen"
    }
  }
}
