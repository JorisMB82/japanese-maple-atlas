{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas governed media object",
  "type": "object",
  "required": [
    "id",
    "cultivarId",
    "mediaType",
    "role",
    "status",
    "assetPath",
    "altText",
    "creator",
    "rightsHolder",
    "licence",
    "source",
    "identification",
    "privacy",
    "evidentiaryStatus",
    "derivatives",
    "approvalHistory"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^MED-RC-[0-9]{3}-[A-Z]+-[0-9]{3}$" },
    "cultivarId": { "type": "string", "pattern": "^RC-[0-9]{3}$" },
    "mediaType": { "enum": ["atlas-illustration", "photograph", "scan", "diagram", "map", "specimen-image"] },
    "role": { "type": "string", "minLength": 1 },
    "subject": { "type": "string" },
    "season": { "type": "string" },
    "status": { "enum": ["reserved", "draft", "approved", "deprecated"] },
    "assetPath": { "type": "string" },
    "thumbnailPath": { "type": ["string", "null"] },
    "altText": { "type": "string", "minLength": 20 },
    "caption": { "type": "string" },
    "creator": { "type": "string", "minLength": 1 },
    "contributor": { "type": "string" },
    "rightsHolder": { "type": "string", "minLength": 1 },
    "licence": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "preservation"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "preservation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "identification": {
      "type": "object",
      "required": ["specimenIdentity", "confidence", "editorialStatus"],
      "properties": {
        "specimenIdentity": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "minLength": 1 },
        "editorialStatus": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["exifRetained", "gpsRetained", "locationGranularity"],
      "properties": {
        "exifRetained": { "type": "boolean" },
        "gpsRetained": { "type": "boolean" },
        "locationGranularity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidentiaryStatus": { "enum": ["illustrative-not-evidence", "supporting-evidence", "primary-evidence", "context-only"] },
    "syntheticLabel": { "type": "string", "minLength": 20 },
    "styleVersion": { "type": "string" },
    "focalPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "derivatives": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["profile", "path", "width", "height", "mimeType", "sha256", "derivedFrom"],
        "properties": {
          "profile": { "enum": ["thumb", "card", "display", "archive"] },
          "path": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "mimeType": { "enum": ["image/svg+xml", "image/jpeg", "image/png"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "derivedFrom": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "approvalHistory": { "type": "array", "minItems": 1 },
    "reviewNotes": { "type": "string" }
  },
  "oneOf": [
    {
      "required": ["syntheticLabel"],
      "properties": {
        "mediaType": { "const": "atlas-illustration" },
        "evidentiaryStatus": { "const": "illustrative-not-evidence" }
      }
    },
    {
      "properties": {
        "mediaType": { "enum": ["photograph", "scan", "diagram", "map", "specimen-image"] }
      }
    }
  ],
  "additionalProperties": false
}
