{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/assertion.schema.json",
  "title": "Compiled Atlas Assertion",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "subjectId",
    "domain",
    "predicate",
    "statement",
    "state",
    "confidence",
    "evidenceIds",
    "sourceScope",
    "generatedFrom"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AST-[0-9]{6}$"
    },
    "subjectId": {
      "type": "string",
      "pattern": "^RC-[0-9]{3}$"
    },
    "state": {
      "enum": [
        "approved",
        "approved-qualified"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVD-[0-9]{6}$"
      }
    }
  }
}
