{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/evidence.schema.json",
  "title": "Compiled Reference Standard Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "evidenceType",
    "scope",
    "sourceId",
    "status",
    "note",
    "assertionIds",
    "sourceLocation",
    "sourceSha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVD-[0-9]{6}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^SRC-(?:[0-9]{6}|RC-[0-9]{3}-[0-9]{3})$"
    },
    "status": {
      "const": "approved"
    },
    "assertionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AST-[0-9]{6}$"
      }
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-(?:[0-9]{6}|RC-[0-9]{3}-[0-9]{3})$"
      }
    },
    "sourceLocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^SRC-(?:[0-9]{6}|RC-[0-9]{3}-[0-9]{3})$"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
