{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Evidence",
  "type": "object",
  "required": [
    "id",
    "evidenceType",
    "scope",
    "sourceId",
    "status"
  ],
  "properties": {
    "id": {
      "pattern": "^EVD-[0-9]{6}$"
    },
    "sourceId": {
      "pattern": "^SRC-"
    }
  }
}
