{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/manifest.schema.json",
  "title": "Atlas Compiler Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositoryVersion",
    "release",
    "generatedAt",
    "compiler",
    "contract",
    "source",
    "editorial",
    "graph",
    "objectCounts",
    "objectTotal",
    "repositoryHash",
    "canonicality",
    "notes"
  ],
  "properties": {
    "repositoryVersion": {
      "const": "0.11.0"
    },
    "release": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "compiler": {
      "type": "object",
      "required": [
        "name",
        "version",
        "deterministic",
        "atomicPublication"
      ],
      "properties": {
        "name": {
          "const": "Atlas Compiler"
        },
        "version": {
          "const": "2.0.0"
        },
        "deterministic": {
          "const": true
        },
        "atomicPublication": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [
        "version",
        "profile",
        "effectiveFromRecord",
        "legacyAdapters",
        "governedExceptions"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "profile": {
          "const": "canonical-rc-v1"
        },
        "effectiveFromRecord": {
          "const": "RC-006"
        },
        "legacyAdapters": {
          "type": "integer",
          "minimum": 0
        },
        "governedExceptions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "records",
        "canonicalSources",
        "underlyingSources",
        "inputHash"
      ],
      "properties": {
        "type": {
          "const": "frozen-reference-standard-cohort"
        },
        "records": {
          "type": "integer",
          "minimum": 1
        },
        "canonicalSources": {
          "type": "integer",
          "minimum": 1
        },
        "underlyingSources": {
          "type": "integer",
          "minimum": 0
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "editorial": {
      "type": "object",
      "required": [
        "contributors",
        "submissions",
        "workflows",
        "reviews",
        "lifecycleStages",
        "reviewPasses"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "relationshipTypes",
        "categories",
        "graphHash"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "relationshipTypes": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "object",
          "required": [
            "taxonomy",
            "morphology",
            "architecture",
            "seasonal-expression",
            "cultivation",
            "diagnosis"
          ]
        },
        "graphHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "objectCounts": {
      "type": "object",
      "required": [
        "cultivars",
        "assertions",
        "evidence",
        "sources",
        "taxa",
        "relationships",
        "relationshipTypes",
        "media",
        "contributors",
        "submissions",
        "editorialWorkflows",
        "editorialReviews"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "objectTotal": {
      "type": "integer",
      "minimum": 1
    },
    "repositoryHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonicality": {
      "const": "canonical-compiled"
    },
    "notes": {
      "type": "string"
    }
  }
}
