{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japanese-maple-atlas.org/schemas/manifest.schema.json",
  "title": "Atlas Compiler Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositoryVersion",
    "release",
    "generatedAt",
    "compiler",
    "source",
    "editorial",
    "graph",
    "objectCounts",
    "objectTotal",
    "repositoryHash",
    "canonicality",
    "notes"
  ],
  "properties": {
    "repositoryVersion": { "const": "0.9.0" },
    "release": { "type": "string" },
    "generatedAt": { "type": "string" },
    "compiler": {
      "type": "object",
      "required": ["name", "version", "deterministic"],
      "properties": {
        "name": { "const": "Atlas Compiler" },
        "version": { "const": "1.2.0" },
        "deterministic": { "const": true }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "records", "inputHash"],
      "properties": {
        "records": { "const": 5 },
        "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "editorial": {
      "type": "object",
      "required": ["contributors", "submissions", "workflows", "reviews", "lifecycleStages", "reviewPasses"]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "relationshipTypes", "categories", "graphHash"],
      "properties": {
        "nodes": { "const": 7 },
        "edges": { "const": 26 },
        "relationshipTypes": { "const": 10 },
        "categories": {
          "type": "object",
          "required": ["taxonomy", "morphology", "architecture", "seasonal-expression", "cultivation", "diagnosis"]
        },
        "graphHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "objectCounts": {
      "type": "object",
      "required": [
        "cultivars",
        "assertions",
        "evidence",
        "sources",
        "taxa",
        "relationships",
        "relationshipTypes",
        "media",
        "contributors",
        "submissions",
        "editorialWorkflows",
        "editorialReviews"
      ]
    },
    "objectTotal": { "const": 235 },
    "repositoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicality": { "const": "canonical-compiled" },
    "notes": { "type": "string" }
  }
}
